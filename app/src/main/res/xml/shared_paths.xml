<?xml version="1.0" encoding="utf-8"?>
<!--
  Что можно отдавать наружу через FileProvider.

  Только одна папка — `diag/` внутри кэша. Не `cache-path .` целиком: там
  лежат скачанные треки и промежуточные файлы, и открывать их чужим
  приложениям ради кнопки «отправить отчёт» — это отдать лишнее.
-->
<paths>
    <cache-path name="diag" path="diag/" />
</paths>
