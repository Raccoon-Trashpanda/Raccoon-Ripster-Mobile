<?xml version="1.0" encoding="utf-8"?>
<!--
    Тематическая иконка (Android 13+): монокромный слой берёт силуэт
    foreground-логотипа как есть — лаунчер закрашивает его цветом системной
    темы, важны только альфа-каналы (проверено: 61% пикселей прозрачные,
    сам знак непрозрачен).

    Сознательно БЕЗ activity-alias переключения иконок по теме: на части
    лаунчеров смена alias пересоздаёт компонент, и с рабочего стола слетают
    закреплённые ярлыки/виджеты. Монохромный слой — штатный механизм темы,
    он ничего не пересоздаёт.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
    <monochrome android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
